# MedNavbat Backend Server — Environment Variables
# Bu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring:
#   cp .env.example .env

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# CORS: Frontend domenini ko'rsating (vergul bilan ajratilgan)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── OTP Xavfsizlik ──────────────────────────────────────────────────────────
# Ixtiyoriy: HMAC imzo uchun maxfiy kalit (32+ belgidan iborat)
OTP_SECRET=your_strong_otp_secret_32chars_min

# ── Chipta Imzolash ──────────────────────────────────────────────────────────
# Ixtiyoriy: QR token HMAC imzosi uchun maxfiy kalit
TICKET_SECRET=your_strong_ticket_secret_32chars_min

# ── SMS Rejimi ──────────────────────────────────────────────────────────────
# SMS_MODE=mock   → Kod faqat terminalga chiqadi (default, test uchun)
# SMS_MODE=eskiz  → Haqiqiy SMS Eskiz.uz orqali yuboriladi
SMS_MODE=mock

# ── Eskiz.uz (SMS_MODE=eskiz bo'lsa to'ldiring) ──────────────────────────────
# https://eskiz.uz dan ro'yxatdan o'ting va kredensiallarnigizni kiriting
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password

# Eskiz Sender ID (rasmiy ro'yxatdan o'tgan)
ESKIZ_FROM=4546
